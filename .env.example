# ===================================================
# বংশধারা (Bongshodhara) - Environment Variables
# ===================================================

# 1. Supabase API Credentials (Required for Vercel deployment)
# Retrieve from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# 2. Production Site URL (Optional but recommended for custom domain or production link)
# e.g. https://bongshodhara.vercel.app (without trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
